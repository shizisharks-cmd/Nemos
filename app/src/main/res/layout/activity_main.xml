<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#0B0B12"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="20dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="⚡ NEMOS MODS"
                android:textColor="#FFFFFF"
                android:textSize="24sp"
                android:textStyle="bold" />

            <Button
                android:id="@+id/btnLogout"
                android:layout_width="wrap_content"
                android:layout_height="36dp"
                android:background="@drawable/bg_card_unselected"
                android:paddingHorizontal="14dp"
                android:text="Выйти"
                android:textAllCaps="false"
                android:textColor="#A1A1AA"
                android:textSize="12sp" />
        </LinearLayout>

        <TextView
            android:id="@+id/tvSubInfo"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:text="Ключ: АКТИВЕН"
            android:textColor="#2DD4BF"
            android:textSize="12sp"
            android:textStyle="bold" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="44dp"
            android:layout_marginTop="16dp"
            android:background="@drawable/bg_card_unselected"
            android:orientation="horizontal"
            android:padding="3dp">

            <Button
                android:id="@+id/btnTabShizuku"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:background="@drawable/bg_card_selected"
                android:text="⚡ 1-Клик (Shizuku)"
                android:textAllCaps="false"
                android:textColor="#FFFFFF"
                android:textSize="12sp"
                android:textStyle="bold" />

            <Button
                android:id="@+id/btnTabMt"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:background="@android:color/transparent"
                android:text="📁 MT Manager"
                android:textAllCaps="false"
                android:textColor="#A1A1AA"
                android:textSize="12sp"
                android:textStyle="bold" />
        </LinearLayout>

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="18dp"
            android:layout_marginBottom="10dp"
            android:text="ВЫБЕРИ СБОРКУ"
            android:textColor="#A855F7"
            android:textSize="12sp"
            android:textStyle="bold" />

        <!-- СБОРКА МОЛОДОЙ -->
        <LinearLayout
            android:id="@+id/cardMolodoy"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="10dp"
            android:background="@drawable/bg_card_selected"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:padding="16dp">

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="🔥 Сборка Molodoy"
                    android:textColor="#FFFFFF"
                    android:textSize="17sp"
                    android:textStyle="bold" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="2dp"
                    android:text="Кастомный таймцикл и реалистичные текстуры"
                    android:textColor="#A1A1AA"
                    android:textSize="12sp" />
            </LinearLayout>

            <TextView
                android:id="@+id/tvBadgeMolodoy"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="✓ ВЫБРАНО"
                android:textColor="#2DD4BF"
                android:textSize="11sp"
                android:textStyle="bold" />
        </LinearLayout>

        <!-- СБОРКА KARMA ДЛЯ ФВ -->
        <LinearLayout
            android:id="@+id/cardKarma"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="10dp"
            android:background="@drawable/bg_card_unselected"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:padding="16dp">

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="🎯 Чит сб для ФВ (Karma)"
                    android:textColor="#FFFFFF"
                    android:textSize="17sp"
                    android:textStyle="bold" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="2dp"
                    android:text="Таймцикл, прицелы, текстуры и конфиги для каптов"
                    android:textColor="#A1A1AA"
                    android:textSize="12sp" />
            </LinearLayout>

            <TextView
                android:id="@+id/tvBadgeKarma"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="✓ ВЫБРАНО"
                android:textColor="#2DD4BF"
                android:textSize="11sp"
                android:textStyle="bold"
                android:visibility="gone" />
        </LinearLayout>

        <!-- FPS BOOST -->
        <LinearLayout
            android:id="@+id/cardFps"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="10dp"
            android:background="@drawable/bg_card_unselected"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:padding="16dp">

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="⚡ FPS Boost"
                    android:textColor="#FFFFFF"
                    android:textSize="17sp"
                    android:textStyle="bold" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="2dp"
                    android:text="Максимум FPS для слабых телефонов"
                    android:textColor="#A1A1AA"
                    android:textSize="12sp" />
            </LinearLayout>

            <TextView
                android:id="@+id/tvBadgeFps"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="✓ ВЫБРАНО"
                android:textColor="#2DD4BF"
                android:textSize="11sp"
                android:textStyle="bold"
                android:visibility="gone" />
        </LinearLayout>

        <!-- GHETTO PACK -->
        <LinearLayout
            android:id="@+id/cardGhetto"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="10dp"
            android:background="@drawable/bg_card_unselected"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:padding="16dp">

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="🔫 Ghetto Pack"
                    android:textColor="#FFFFFF"
                    android:textSize="17sp"
                    android:textStyle="bold" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="2dp"
                    android:text="Прицелы, звуки выстрелов и эффекты"
                    android:textColor="#A1A1AA"
                    android:textSize="12sp" />
            </LinearLayout>

            <TextView
                android:id="@+id/tvBadgeGhetto"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="✓ ВЫБРАНО"
                android:textColor="#2DD4BF"
                android:textSize="11sp"
                android:textStyle="bold"
                android:visibility="gone" />
        </LinearLayout>

        <!-- СВОЙ ZIP-АРХИВ -->
        <LinearLayout
            android:id="@+id/cardCustom"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="20dp"
            android:background="@drawable/bg_card_unselected"
            android:orientation="vertical"
            android:padding="16dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:orientation="vertical">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="📦 Свой ZIP-архив"
                        android:textColor="#FFFFFF"
                        android:textSize="17sp"
                        android:textStyle="bold" />

                    <TextView
                        android:id="@+id/tvCustomZipName"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="2dp"
                        android:text="Выбрать архив из загрузок"
                        android:textColor="#A1A1AA"
                        android:textSize="12sp" />
                </LinearLayout>

                <TextView
                    android:id="@+id/tvBadgeCustom"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="✓ ВЫБРАНО"
                    android:textColor="#2DD4BF"
                    android:textSize="11sp"
                    android:textStyle="bold"
                    android:visibility="gone" />
            </LinearLayout>

            <Button
                android:id="@+id/btnPickZip"
                android:layout_width="match_parent"
                android:layout_height="40dp"
                android:layout_marginTop="10dp"
                android:background="@drawable/bg_btn_outline"
                android:text="📁 Выбрать файл .zip"
                android:textAllCaps="false"
                android:textColor="#E9D5FF"
                android:textSize="13sp" />
        </LinearLayout>

        <!-- РЕЖИМ 1-КЛИК: SHIZUKU (РОВНО 1 КНОПКА) -->
        <LinearLayout
            android:id="@+id/layoutShizukuView"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <TextView
                android:id="@+id/tvShizukuStatus"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="10dp"
                android:gravity="center"
                android:text="⏳ Проверка Shizuku..."
                android:textColor="#2DD4BF"
                android:textSize="13sp"
                android:textStyle="bold" />

            <Button
                android:id="@+id/btnShizukuInstall"
                android:layout_width="match_parent"
                android:layout_height="56dp"
                android:background="@drawable/bg_btn_primary"
                android:text="🚀 УСТАНОВИТЬ И ВОЙТИ В ИГРУ (1 КЛИК)"
                android:textAllCaps="true"
                android:textColor="#FFFFFF"
                android:textSize="15sp"
                android:textStyle="bold" />
        </LinearLayout>

        <!-- РЕЖИМ MT MANAGER -->
        <LinearLayout
            android:id="@+id/layoutMtView"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:visibility="gone">

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="10dp"
                android:background="@drawable/bg_card_unselected"
                android:padding="12dp"
                android:text="💡 Нажми кнопку ниже — MT Manager сразу откроется на папке files.\nОстанется только скопировать её справа в:\nAndroid → data → com.grandmobile.game"
                android:textColor="#E4E4E7"
                android:textSize="12sp" />

            <Button
                android:id="@+id/btnMtInstallAndOpen"
                android:layout_width="match_parent"
                android:layout_height="56dp"
                android:background="@drawable/bg_btn_primary"
                android:text="📂 ОТКРЫТЬ ПАПКУ FILES В MT MANAGER"
                android:textAllCaps="true"
                android:textColor="#FFFFFF"
                android:textSize="14sp"
                android:textStyle="bold" />

            <Button
                android:id="@+id/btnMtLaunchGame"
                android:layout_width="match_parent"
                android:layout_height="46dp"
                android:layout_marginTop="10dp"
                android:background="@drawable/bg_card_selected"
                android:text="🎮 Запустить Grand Mobile"
                android:textAllCaps="false"
                android:textColor="#FFFFFF"
                android:textSize="14sp"
                android:textStyle="bold" />
        </LinearLayout>

        <TextView
            android:id="@+id/tvStatus"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="14dp"
            android:gravity="center"
            android:text="Сборка готова к запуску"
            android:textColor="#A1A1AA"
            android:textSize="13sp" />

    </LinearLayout>
</ScrollView>
