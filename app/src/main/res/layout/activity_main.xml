<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#0B0B12"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="20dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="⚡ NEMOS MODS"
                android:textColor="#FFFFFF"
                android:textSize="26sp"
                android:textStyle="bold" />

            <Button
                android:id="@+id/btnLogout"
                android:layout_width="wrap_content"
                android:layout_height="38dp"
                android:background="@drawable/bg_card_unselected"
                android:paddingHorizontal="16dp"
                android:text="Выйти"
                android:textAllCaps="false"
                android:textColor="#A1A1AA"
                android:textSize="13sp" />
        </LinearLayout>

        <TextView
            android:id="@+id/tvSubInfo"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:text="Ключ: АКТИВЕН"
            android:textColor="#2DD4BF"
            android:textSize="13sp"
            android:textStyle="bold" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="22dp"
            android:layout_marginBottom="10dp"
            android:letterSpacing="0.08"
            android:text="ВЫБЕРИ СБОРКУ"
            android:textColor="#A855F7"
            android:textSize="13sp"
            android:textStyle="bold" />

        <!-- Card: Molodoy -->
        <LinearLayout
            android:id="@+id/cardMolodoy"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="12dp"
            android:background="@drawable/bg_card_selected"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:padding="18dp">

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="🔥 Сборка Molodoy"
                    android:textColor="#FFFFFF"
                    android:textSize="18sp"
                    android:textStyle="bold" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="4dp"
                    android:text="Кастомный таймцикл и текстуры (Molodoy)"
                    android:textColor="#A1A1AA"
                    android:textSize="13sp" />
            </LinearLayout>

            <TextView
                android:id="@+id/tvBadgeMolodoy"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="✓ ВЫБРАНО"
                android:textColor="#2DD4BF"
                android:textSize="12sp"
                android:textStyle="bold" />
        </LinearLayout>

        <!-- Card: FPS Boost -->
        <LinearLayout
            android:id="@+id/cardFps"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="12dp"
            android:background="@drawable/bg_card_unselected"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:padding="18dp">

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="⚡ FPS Boost"
                    android:textColor="#FFFFFF"
                    android:textSize="18sp"
                    android:textStyle="bold" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="4dp"
                    android:text="Для слабых телефонов"
                    android:textColor="#A1A1AA"
                    android:textSize="13sp" />
            </LinearLayout>

            <TextView
                android:id="@+id/tvBadgeFps"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="✓ ВЫБРАНО"
                android:textColor="#2DD4BF"
                android:textSize="12sp"
                android:textStyle="bold"
                android:visibility="gone" />
        </LinearLayout>

        <!-- Card: Ghetto Pack -->
        <LinearLayout
            android:id="@+id/cardGhetto"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="12dp"
            android:background="@drawable/bg_card_unselected"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:padding="18dp">

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="🎯 Ghetto Pack"
                    android:textColor="#FFFFFF"
                    android:textSize="18sp"
                    android:textStyle="bold" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="4dp"
                    android:text="Звуки и эффекты стрельбы"
                    android:textColor="#A1A1AA"
                    android:textSize="13sp" />
            </LinearLayout>

            <TextView
                android:id="@+id/tvBadgeGhetto"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="✓ ВЫБРАНО"
                android:textColor="#2DD4BF"
                android:textSize="12sp"
                android:textStyle="bold"
                android:visibility="gone" />
        </LinearLayout>

        <!-- Card: Custom ZIP -->
        <LinearLayout
            android:id="@+id/cardCustom"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="20dp"
            android:background="@drawable/bg_card_unselected"
            android:orientation="vertical"
            android:padding="18dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:orientation="vertical">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="📦 Своя сборка (.ZIP)"
                        android:textColor="#FFFFFF"
                        android:textSize="18sp"
                        android:textStyle="bold" />

                    <TextView
                        android:id="@+id/tvCustomZipName"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="4dp"
                        android:text="Загрузи свой архив с модами"
                        android:textColor="#A1A1AA"
                        android:textSize="13sp" />
                </LinearLayout>

                <TextView
                    android:id="@+id/tvBadgeCustom"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="✓ ВЫБРАНО"
                    android:textColor="#2DD4BF"
                    android:textSize="12sp"
                    android:textStyle="bold"
                    android:visibility="gone" />
            </LinearLayout>

            <Button
                android:id="@+id/btnPickZip"
                android:layout_width="match_parent"
                android:layout_height="44dp"
                android:layout_marginTop="14dp"
                android:background="@drawable/bg_btn_outline"
                android:text="📁 Выбрать .ZIP архив"
                android:textAllCaps="false"
                android:textColor="#E9D5FF"
                android:textSize="14sp"
                android:textStyle="bold" />
        </LinearLayout>

        <Button
            android:id="@+id/btnPlay"
            android:layout_width="match_parent"
            android:layout_height="58dp"
            android:background="@drawable/bg_btn_primary"
            android:text="🚀 ИГРАТЬ С МОДАМИ"
            android:textAllCaps="true"
            android:textColor="#FFFFFF"
            android:textSize="16sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/tvStatus"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:gravity="center"
            android:text="Сборка Molodoy готова к запуску"
            android:textColor="#A1A1AA"
            android:textSize="13sp" />

        <!-- Settings Section -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="18dp"
            android:background="@drawable/bg_card_unselected"
            android:orientation="vertical"
            android:padding="16dp">

            <LinearLayout
                android:id="@+id/btnToggleSettings"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="⚙️ Настройки"
                    android:textColor="#FFFFFF"
                    android:textSize="15sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/tvSettingsToggle"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Показать ▼"
                    android:textColor="#A855F7"
                    android:textSize="13sp"
                    android:textStyle="bold" />
            </LinearLayout>

            <LinearLayout
                android:id="@+id/layoutSettingsContent"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="14dp"
                android:orientation="vertical"
                android:visibility="gone">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Задержка Hot-Swap (сек):"
                    android:textColor="#A1A1AA"
                    android:textSize="13sp" />

                <EditText
                    android:id="@+id/etSwapDelay"
                    android:layout_width="match_parent"
                    android:layout_height="44dp"
                    android:layout_marginTop="6dp"
                    android:background="@drawable/bg_btn_outline"
                    android:inputType="number"
                    android:paddingHorizontal="12dp"
                    android:text="17"
                    android:textColor="#FFFFFF"
                    android:textSize="14sp" />

                <Button
                    android:id="@+id/btnSaveSettings"
                    android:layout_width="match_parent"
                    android:layout_height="44dp"
                    android:layout_marginTop="10dp"
                    android:background="@drawable/bg_btn_primary"
                    android:text="Сохранить"
                    android:textAllCaps="false"
                    android:textColor="#FFFFFF"
                    android:textSize="14sp" />
            </LinearLayout>
        </LinearLayout>

    </LinearLayout>
</ScrollView>
