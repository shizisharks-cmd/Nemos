<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#0A0A12"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="20dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="⚡ NEMOS MODS"
                android:textColor="#FFFFFF"
                android:textSize="22sp"
                android:textStyle="bold" />

            <Button
                android:id="@+id/btnBuySub"
                android:layout_width="wrap_content"
                android:layout_height="34dp"
                android:layout_marginEnd="8dp"
                android:background="@drawable/bg_card_unselected"
                android:paddingHorizontal="10dp"
                android:text="Продлить"
                android:textAllCaps="false"
                android:textColor="#2DD4BF"
                android:textSize="11sp" />

            <Button
                android:id="@+id/btnLogout"
                android:layout_width="wrap_content"
                android:layout_height="34dp"
                android:background="@drawable/bg_card_unselected"
                android:paddingHorizontal="10dp"
                android:text="Выйти"
                android:textAllCaps="false"
                android:textColor="#A1A1AA"
                android:textSize="11sp" />
        </LinearLayout>

        <TextView
            android:id="@+id/tvSubInfo"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:text="Ключ: АКТИВЕН • До: 2027-01-01"
            android:textColor="#2DD4BF"
            android:textSize="12sp"
            android:textStyle="bold" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="44dp"
            android:layout_marginTop="16dp"
            android:background="@drawable/bg_card_unselected"
            android:orientation="horizontal"
            android:padding="3dp">

            <Button
                android:id="@+id/btnTabShizuku"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:background="@drawable/bg_card_selected"
                android:text="⚡ Авто-Вход (Shizuku)"
                android:textAllCaps="false"
                android:textColor="#FFFFFF"
                android:textSize="12sp"
                android:textStyle="bold" />

            <Button
                android:id="@+id/btnTabMt"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:background="@android:color/transparent"
                android:text="📁 MT Manager"
                android:textAllCaps="false"
                android:textColor="#A1A1AA"
                android:textSize="12sp"
                android:textStyle="bold" />
        </LinearLayout>

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="18dp"
            android:layout_marginBottom="10dp"
            android:text="ВЫБЕРИТЕ СБОРКУ"
            android:textColor="#A855F7"
            android:textSize="12sp"
            android:textStyle="bold" />

        <!-- Карточка Кармы -->
        <LinearLayout
            android:id="@+id/cardKarma"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="10dp"
            android:background="@drawable/bg_card_selected"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:padding="16dp">

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="🎯 Чит сб для ФВ (Karma)"
                    android:textColor="#FFFFFF"
                    android:textSize="16sp"
                    android:textStyle="bold" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="2dp"
                    android:text="Таймцикл, прицелы, текстуры mobile и конфиги"
                    android:textColor="#A1A1AA"
                    android:textSize="11sp" />
            </LinearLayout>

            <TextView
                android:id="@+id/tvBadgeKarma"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="✓ ВЫБРАНО"
                android:textColor="#2DD4BF"
                android:textSize="11sp"
                android:textStyle="bold" />
        </LinearLayout>

        <!-- Карточка Molodoy -->
        <LinearLayout
            android:id="@+id/cardMolodoy"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="10dp"
            android:background="@drawable/bg_card_unselected"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:padding="16dp">

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="🔥 Сборка Molodoy"
                    android:textColor="#FFFFFF"
                    android:textSize="16sp"
                    android:textStyle="bold" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="2dp"
                    android:text="Кастомный таймцикл и реалистичные текстуры"
                    android:textColor="#A1A1AA"
                    android:textSize="11sp" />
            </LinearLayout>

            <TextView
                android:id="@+id/tvBadgeMolodoy"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="✓ ВЫБРАНО"
                android:textColor="#2DD4BF"
                android:textSize="11sp"
                android:textStyle="bold"
                android:visibility="gone" />
        </LinearLayout>

        <!-- Карточка FPS Boost -->
        <LinearLayout
            android:id="@+id/cardFps"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="10dp"
            android:background="@drawable/bg_card_unselected"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:padding="16dp">

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="⚡ FPS Boost"
                    android:textColor="#FFFFFF"
                    android:textSize="16sp"
                    android:textStyle="bold" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="2dp"
                    android:text="Максимум FPS для слабых телефонов"
                    android:textColor="#A1A1AA"
                    android:textSize="11sp" />
            </LinearLayout>

            <TextView
                android:id="@+id/tvBadgeFps"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="✓ ВЫБРАНО"
                android:textColor="#2DD4BF"
                android:textSize="11sp"
                android:textStyle="bold"
                android:visibility="gone" />
        </LinearLayout>

        <!-- Карточка своего ZIP -->
        <LinearLayout
            android:id="@+id/cardCustom"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="20dp"
            android:background="@drawable/bg_card_unselected"
            android:orientation="vertical"
            android:padding="16dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:orientation="vertical">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="📦 Свой ZIP-архив"
                        android:textColor="#FFFFFF"
                        android:textSize="16sp"
                        android:textStyle="bold" />

                    <TextView
                        android:id="@+id/tvCustomZipName"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="2dp"
                        android:text="Выбрать zip-файл из Загрузок"
                        android:textColor="#A1A1AA"
                        android:textSize="11sp" />
                </LinearLayout>

                <TextView
                    android:id="@+id/tvBadgeCustom"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="✓ ВЫБРАНО"
                    android:textColor="#2DD4BF"
                    android:textSize="11sp"
                    android:textStyle="bold"
                    android:visibility="gone" />
            </LinearLayout>

            <Button
                android:id="@+id/btnPickZip"
                android:layout_width="match_parent"
                android:layout_height="38dp"
                android:layout_marginTop="10dp"
                android:background="@drawable/bg_card_selected"
                android:text="📁 Выбрать файл .zip"
                android:textAllCaps="false"
                android:textColor="#E9D5FF"
                android:textSize="12sp" />
        </LinearLayout>

        <!-- Секция SHIZUKU: ПОЛНЫЙ АВТОМАТ -->
        <LinearLayout
            android:id="@+id/layoutShizukuView"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <TextView
                android:id="@+id/tvShizukuStatus"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="10dp"
                android:gravity="center"
                android:text="🟢 Shizuku активен: всё готово к авто-входу"
                android:textColor="#2DD4BF"
                android:textSize="13sp"
                android:textStyle="bold" />

            <Button
                android:id="@+id/btnAutoStart"
                android:layout_width="match_parent"
                android:layout_height="56dp"
                android:background="@drawable/bg_btn_primary"
                android:text="🚀 АВТО-ВХОД СО СБОРКОЙ (1 КЛИК)"
                android:textAllCaps="true"
                android:textColor="#FFFFFF"
                android:textSize="14sp"
                android:textStyle="bold" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:gravity="center"
                android:text="💡 Нажмите один раз: игра запустится, а сборка автоматически внедрится во время загрузки карты."
                android:textColor="#71717A"
                android:textSize="11sp" />
        </LinearLayout>

        <!-- Секция MT MANAGER -->
        <LinearLayout
            android:id="@+id/layoutMtView"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:visibility="gone">

            <Button
                android:id="@+id/btnMtPrepare"
                android:layout_width="match_parent"
                android:layout_height="52dp"
                android:background="@drawable/bg_btn_primary"
                android:text="1️⃣ Распаковать сборку в Загрузки"
                android:textAllCaps="false"
                android:textColor="#FFFFFF"
                android:textSize="14sp"
                android:textStyle="bold" />

            <Button
                android:id="@+id/btnMtOpen"
                android:layout_width="match_parent"
                android:layout_height="48dp"
                android:layout_marginTop="10dp"
                android:background="@drawable/bg_card_selected"
                android:text="2️⃣ Открыть MT Manager"
                android:textAllCaps="false"
                android:textColor="#E9D5FF"
                android:textSize="14sp"
                android:textStyle="bold" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:text="💡 В MT Manager скопируйте папки data, texdb и audio в Android/data/com.grand.launcher/files/"
                android:textColor="#71717A"
                android:textSize="11sp" />
        </LinearLayout>

        <TextView
            android:id="@+id/tvStatus"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:gravity="center"
            android:text="Лаунчер готов к работе"
            android:textColor="#A1A1AA"
            android:textSize="13sp" />

    </LinearLayout>
</ScrollView>
