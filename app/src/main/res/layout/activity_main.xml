<?xml version="1.0" encoding="utf-8"?>
<ScrollView android:background="#0B0B12" android:fillViewport="true" android:layout_height="match_parent" android:layout_width="match_parent" xmlns:android="http://schemas.android.com/apk/res/android">

    <LinearLayout android:layout_height="wrap_content" android:layout_width="match_parent" android:orientation="vertical" android:padding="20dp">

        <LinearLayout android:gravity="center_vertical" android:layout_height="wrap_content" android:layout_width="match_parent" android:orientation="horizontal">

            <TextView android:layout_height="wrap_content" android:layout_weight="1" android:layout_width="0dp" android:text="⚡ NEMOS MODS" android:textColor="#FFFFFF" android:textSize="24sp" android:textStyle="bold"/>

            <Button android:background="@drawable/bg_card_unselected" android:id="@+id/btnLogout" android:layout_height="36dp" android:layout_width="wrap_content" android:paddingHorizontal="14dp" android:text="Выйти" android:textAllCaps="false" android:textColor="#A1A1AA" android:textSize="12sp"/>
        </LinearLayout>

        <LinearLayout android:gravity="center_vertical" android:layout_height="wrap_content" android:layout_marginTop="6dp" android:layout_width="match_parent" android:orientation="horizontal">

            <TextView android:id="@+id/tvSubInfo" android:layout_height="wrap_content" android:layout_weight="1" android:layout_width="0dp" android:text="Ключ: АКТИВЕН" android:textColor="#2DD4BF" android:textSize="12sp" android:textStyle="bold"/>

            <TextView android:id="@+id/tvShizukuBadge" android:layout_height="wrap_content" android:layout_width="wrap_content" android:text="⏳ Проверка режима..." android:textColor="#A1A1AA" android:textSize="12sp" android:textStyle="bold"/>
        </LinearLayout>

        <TextView android:layout_height="wrap_content" android:layout_marginBottom="10dp" android:layout_marginTop="20dp" android:layout_width="match_parent" android:text="ВЫБЕРИ СБОРКУ" android:textColor="#A855F7" android:textSize="12sp" android:textStyle="bold"/>

        <LinearLayout android:background="@drawable/bg_card_selected" android:gravity="center_vertical" android:id="@+id/cardMolodoy" android:layout_height="wrap_content" android:layout_marginBottom="10dp" android:layout_width="match_parent" android:orientation="horizontal" android:padding="16dp">

            <LinearLayout android:layout_height="wrap_content" android:layout_weight="1" android:layout_width="0dp" android:orientation="vertical">

                <TextView android:layout_height="wrap_content" android:layout_width="wrap_content" android:text="🔥 Сборка Molodoy" android:textColor="#FFFFFF" android:textSize="17sp" android:textStyle="bold"/>

                <TextView android:layout_height="wrap_content" android:layout_marginTop="2dp" android:layout_width="wrap_content" android:text="Кастомный таймцикл и реалистичные текстуры" android:textColor="#A1A1AA" android:textSize="12sp"/>
            </LinearLayout>

            <TextView android:id="@+id/tvBadgeMolodoy" android:layout_height="wrap_content" android:layout_width="wrap_content" android:text="✓ ВЫБРАНО" android:textColor="#2DD4BF" android:textSize="11sp" android:textStyle="bold"/>
        </LinearLayout>

        <LinearLayout android:background="@drawable/bg_card_unselected" android:gravity="center_vertical" android:id="@+id/cardFps" android:layout_height="wrap_content" android:layout_marginBottom="10dp" android:layout_width="match_parent" android:orientation="horizontal" android:padding="16dp">

            <LinearLayout android:layout_height="wrap_content" android:layout_weight="1" android:layout_width="0dp" android:orientation="vertical">

                <TextView android:layout_height="wrap_content" android:layout_width="wrap_content" android:text="⚡ FPS Boost" android:textColor="#FFFFFF" android:textSize="17sp" android:textStyle="bold"/>

                <TextView android:layout_height="wrap_content" android:layout_marginTop="2dp" android:layout_width="wrap_content" android:text="Максимум FPS для слабых телефонов" android:textColor="#A1A1AA" android:textSize="12sp"/>
            </LinearLayout>

            <TextView android:id="@+id/tvBadgeFps" android:layout_height="wrap_content" android:layout_width="wrap_content" android:text="✓ ВЫБРАНО" android:textColor="#2DD4BF" android:textSize="11sp" android:textStyle="bold" android:visibility="gone"/>
        </LinearLayout>

        <LinearLayout android:background="@drawable/bg_card_unselected" android:gravity="center_vertical" android:id="@+id/cardGhetto" android:layout_height="wrap_content" android:layout_marginBottom="10dp" android:layout_width="match_parent" android:orientation="horizontal" android:padding="16dp">

            <LinearLayout android:layout_height="wrap_content" android:layout_weight="1" android:layout_width="0dp" android:orientation="vertical">

                <TextView android:layout_height="wrap_content" android:layout_width="wrap_content" android:text="🎯 Ghetto Pack" android:textColor="#FFFFFF" android:textSize="17sp" android:textStyle="bold"/>

                <TextView android:layout_height="wrap_content" android:layout_marginTop="2dp" android:layout_width="wrap_content" android:text="Прицелы, звуки выстрелов и эффекты" android:textColor="#A1A1AA" android:textSize="12sp"/>
            </LinearLayout>

            <TextView android:id="@+id/tvBadgeGhetto" android:layout_height="wrap_content" android:layout_width="wrap_content" android:text="✓ ВЫБРАНО" android:textColor="#2DD4BF" android:textSize="11sp" android:textStyle="bold" android:visibility="gone"/>
        </LinearLayout>

        <LinearLayout android:background="@drawable/bg_card_unselected" android:id="@+id/cardCustom" android:layout_height="wrap_content" android:layout_marginBottom="24dp" android:layout_width="match_parent" android:orientation="vertical" android:padding="16dp">

            <LinearLayout android:gravity="center_vertical" android:layout_height="wrap_content" android:layout_width="match_parent" android:orientation="horizontal">

                <LinearLayout android:layout_height="wrap_content" android:layout_weight="1" android:layout_width="0dp" android:orientation="vertical">

                    <TextView android:layout_height="wrap_content" android:layout_width="wrap_content" android:text="📦 Свой ZIP-архив" android:textColor="#FFFFFF" android:textSize="17sp" android:textStyle="bold"/>

                    <TextView android:id="@+id/tvCustomZipName" android:layout_height="wrap_content" android:layout_marginTop="2dp" android:layout_width="wrap_content" android:text="Выбрать архив из загрузок" android:textColor="#A1A1AA" android:textSize="12sp"/>
                </LinearLayout>

                <TextView android:id="@+id/tvBadgeCustom" android:layout_height="wrap_content" android:layout_width="wrap_content" android:text="✓ ВЫБРАНО" android:textColor="#2DD4BF" android:textSize="11sp" android:textStyle="bold" android:visibility="gone"/>
            </LinearLayout>

            <Button android:background="@drawable/bg_btn_outline" android:id="@+id/btnPickZip" android:layout_height="40dp" android:layout_marginTop="10dp" android:layout_width="match_parent" android:text="📁 Выбрать файл .zip" android:textAllCaps="false" android:textColor="#E9D5FF" android:textSize="13sp"/>
        </LinearLayout>

        <Button android:background="@drawable/bg_btn_primary" android:id="@+id/btnPrimaryAction" android:layout_height="56dp" android:layout_width="match_parent" android:text="🚀 УСТАНОВИТЬ И ИГРАТЬ" android:textAllCaps="true" android:textColor="#FFFFFF" android:textSize="15sp" android:textStyle="bold"/>

        <LinearLayout android:id="@+id/layoutMtOptions" android:layout_height="wrap_content" android:layout_marginTop="10dp" android:layout_width="match_parent" android:orientation="horizontal" android:visibility="gone">

            <Button android:background="@drawable/bg_btn_outline" android:id="@+id/btnOpenMt" android:layout_height="46dp" android:layout_marginEnd="6dp" android:layout_weight="1" android:layout_width="0dp" android:text="📂 MT Manager" android:textAllCaps="false" android:textColor="#E9D5FF" android:textSize="13sp"/>

            <Button android:background="@drawable/bg_card_selected" android:id="@+id/btnLaunchGame" android:layout_height="46dp" android:layout_marginStart="6dp" android:layout_weight="1" android:layout_width="0dp" android:text="🎮 В игру" android:textAllCaps="false" android:textColor="#FFFFFF" android:textSize="13sp" android:textStyle="bold"/>
        </LinearLayout>

        <TextView android:gravity="center" android:id="@+id/tvStatus" android:layout_height="wrap_content" android:layout_marginTop="14dp" android:layout_width="match_parent" android:text="Готово к установке" android:textColor="#A1A1AA" android:textSize="13sp"/>

    </LinearLayout>
</ScrollView>
